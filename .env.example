# -----------------------------------------------------------------------------
# Stellar Live Poll — Environment Variables
# Copy this file to `.env` and adjust if needed. All values below are the
# recommended defaults for the Stellar TESTNET.
#
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# -----------------------------------------------------------------------------

# Horizon API endpoint (Testnet) — used for XLM balances / Friendbot funding.
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint (Testnet) — used to read/write the smart contract and
# to stream contract events.
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (Testnet)
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed Live Poll contract ID (Testnet).
# This is the live contract used by the demo; redeploy your own (see
# docs/DEPLOYMENT.md) and replace this to run a different poll.
VITE_POLL_CONTRACT_ID=CDZCTLFFN5SM6UC3Z46UPHV6BI2GYVJ65GCAOHNVSCMGBWX4GYD4UZXF

# Stellar Expert explorer base URL (Testnet)
VITE_EXPLORER_URL=https://stellar.expert/explorer/testnet

# Friendbot funding endpoint (Testnet)
VITE_FRIENDBOT_URL=https://friendbot.stellar.org
